{
  "title": "JARVIS V5 — Stark Monitoring",
  "uid": "jarvis-v5",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "Request Rate", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(jarvis_requests_total[5m])) by (endpoint)" }]
    },
    {
      "id": 2, "title": "Response Time (p95)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(jarvis_response_seconds_bucket[5m])) by (le, endpoint))" }]
    },
    {
      "id": 3, "title": "Groq API Calls", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(rate(jarvis_groq_calls_total[5m])) by (model, status)" }]
    },
    {
      "id": 4, "title": "Conversations in Memory", "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [{ "expr": "jarvis_memory_conversations" }]
    },
    {
      "id": 5, "title": "Active WebSockets", "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [{ "expr": "jarvis_websockets_active" }]
    },
    {
      "id": 6, "title": "Protocol Triggers", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [{ "expr": "sum(rate(jarvis_protocol_triggers_total[1h])) by (protocol)" }]
    },
    {
      "id": 7, "title": "Threats Detected", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [{ "expr": "sum(rate(jarvis_threats_total[1h])) by (category, severity)" }]
    },
    {
      "id": 8, "title": "CPU / RAM / Disk", "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        { "expr": "jarvis_cpu_percent", "legendFormat": "CPU %" },
        { "expr": "jarvis_ram_percent", "legendFormat": "RAM %" },
        { "expr": "jarvis_disk_percent", "legendFormat": "Disk %" }
      ]
    }
  ]
}
